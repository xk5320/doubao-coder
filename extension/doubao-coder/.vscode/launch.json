{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行豆包编程助手（扩展开发宿主）",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile",
      "env": {
        "ARK_API_KEY": "${env:ARK_API_KEY}"
      }
    }
  ]
}
